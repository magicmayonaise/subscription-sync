# Notion
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=your-database-id-here
NOTION_CATEGORY_ENTERTAINMENT_PAGE_ID=your-entertainment-category-page-id
NOTION_CATEGORY_BUSINESS_PAGE_ID=your-business-category-page-id
NOTION_CATEGORY_EDUCATION_PAGE_ID=your-education-category-page-id
NOTION_CATEGORY_HEALTH_PAGE_ID=your-health-category-page-id
NOTION_CATEGORY_DECORATION_PAGE_ID=your-decoration-category-page-id

# Anthropic (for LLM extraction)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gmail OAuth
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Pipeline settings
LOOKBACK_DAYS=90
CONFIDENCE_THRESHOLD=0.5
